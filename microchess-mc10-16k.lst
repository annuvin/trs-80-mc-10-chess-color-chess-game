0001   0000             ; ======================================================================
0002   0000             ;  MICROCHESS for the Tandy/Radio Shack MC-10 with 16K RAM expansion
0003   0000             ;  Native MC6803 rewrite of Peter Jennings' MicroChess search.
0004   0000             ;
0005   0000             ;  MicroChess (c) 1996-2002 Peter Jennings, peterj@benlo.com
0006   0000             ;  (the evaluation/search algorithm - move generation order, JANUS,
0007   0000             ;   counters, STRATGY, CKMATE - is Jennings'; the code is new)
0008   0000             ;
0009   0000             ;  Differences from the 4K-era program:
0010   0000             ;    * 0x88 mailbox board, rules built into the move generator:
0011   0000             ;      castling, en passant, auto-queen promotion, full legality
0012   0000             ;    * 128x96 four-colour (CG3) display, 12x11 piece sprites
0013   0000             ;    * play either colour (board flips when you play Black)
0014   0000             ;    * own keyboard scanner (the BASIC ROM's workspace lives in the
0015   0000             ;      video RAM that CG3 takes over); Q cold-starts BASIC again
0016   0000             ;
0017   0000             ;  Memory map (16K expansion):  $5000.. code+data   $7C00-$8060 variables
0018   0000             ;                               $8FFF stack         $4000-$4BFF screen
0019   0000             ;  Load:  CLEAR 100,20479 : CLOADM : EXEC 20480
0020   0000             ;  Build: tasm6801 -sym microchess-mc10-16k.asm   (Telemark-compatible)
0021   0000             ; ======================================================================
0022   0000                     .MSFIRST
0023   0000             RAM     .EQU $7C00
0024   5000                     .ORG $5000
0025   5000 7E 58 BC            JMP START
0026   5003             ; ======================================================================
0027   5003             ;  ENGINE  -- native 6803 version of Peter Jennings' MicroChess search
0028   5003             ;  0x88 mailbox board (absolute coordinates), O(1) REVERSE (frame flip),
0029   5003             ;  full legality via attack detection, castling, en passant, auto-queen.
0030   5003             ; ======================================================================
0031   5003             
0032   5003             ; ---- direct page variables ($80-$FF is the 6803's internal RAM) -------
0033   5003             PIECE   .EQU $80        ; current piece index 0-15 (in mover's list)
0034   5003             SQUARE  .EQU $81        ; current destination / working square (0x88 coords)
0035   5003             MOVEN   .EQU $82        ; direction index
0036   5003             STATE   .EQU $83        ; search state (0,4,8,12 counting; $FF.. capture tree)
0037   5003             MYC     .EQU $84        ; mover's colour bit: $00 white, $20 black
0038   5003             OPC     .EQU $85        ; opponent's colour bit
0039   5003             PFWD    .EQU $86        ; pawn forward step for mover ($10 / $F0)
0040   5003             DBLR    .EQU $87        ; rank nibble that triggers second pawn hop ($20 / $50)
0041   5003             PROMR   .EQU $88        ; promotion rank ($70 / $00)
0042   5003             MXP     .EQU $89        ; word: pointer to this frame's direction table
0043   5003             EPSQ    .EQU $8B        ; en-passant target square ($FF none)
0044   5003             VFLAG   .EQU $8C        ; 1 if candidate move captures
0045   5003             CAPID   .EQU $8D        ; captured piece id of candidate (opp colour | idx)
0046   5003             UPTR    .EQU $8E        ; word: undo stack pointer
0047   5003             LISTMODE .EQU $90       ; 1 = collect legal moves instead of searching
0048   5003             LISTPTR .EQU $91        ; word
0049   5003             LISTCNT .EQU $93
0050   5003             PTS     .EQU $94
0051   5003             TMPA    .EQU $95
0052   5003             TMPB    .EQU $96
0053   5003             TMPC    .EQU $97
0054   5003             FROMSQ  .EQU $98
0055   5003             PIDV    .EQU $99
0056   5003             FLAGS   .EQU $9A
0057   5003             CAPSQ   .EQU $9B
0058   5003             MCAP    .EQU $9C
0059   5003             OLDEP   .EQU $9D
0060   5003             EPNEW   .EQU $9E
0061   5003             WCAP0   .EQU $9F
0062   5003             BESTV   .EQU $A0
0063   5003             BESTP   .EQU $A1
0064   5003             BESTM   .EQU $A2
0065   5003             SCORE   .EQU $A3
0066   5003             ATC     .EQU $A5
0067   5003             ATS     .EQU $A6
0068   5003             ATI     .EQU $A7
0069   5003             ATD     .EQU $A8
0070   5003             ATQ     .EQU $A9
0071   5003             ATF     .EQU $AA
0072   5003             CAD     .EQU $AB
0073   5003             CAID    .EQU $AC
0074   5003             CAR     .EQU $AD
0075   5003             CAN     .EQU $AE
0076   5003             CAQ     .EQU $AF
0077   5003             CAC     .EQU $B0
0078   5003             CKH     .EQU $B1
0079   5003             SEARCHOK .EQU $B2
0080   5003             TMPW    .EQU $B3        ; word
0081   5003             ; evaluation tunables (per colour) and score jitter; set by the front end
0082   5003             CBW     .EQU $F5        ; castling bonus, White to move
0083   5003             CEW     .EQU $F6        ; centre/development bonus, White
0084   5003             CBB     .EQU $F7        ; castling bonus, Black
0085   5003             CEB     .EQU $F8        ; centre/development bonus, Black
0086   5003             JIT     .EQU $F9        ; random 0..JIT added to every root score (0 = off)
0087   5003             RNDS    .EQU $EE        ; random state
0088   5003             
0089   5003             ; ---- data RAM (not part of the load image) -------------------------
0090   5003             SQ      .EQU RAM+$000   ; 48 : white ids $00-$0F, black ids $20-$2F ; $CC = captured
0091   5003             PTYPE   .EQU RAM+$030   ; 48 : R=1 B=2 Q=3 N=4 K=8 P=$10
0092   5003             PVAL    .EQU RAM+$060   ; 48 : capture values
0093   5003             MOVED   .EQU RAM+$090   ; 48 : piece has moved
0094   5003             MAIL    .EQU RAM+$0C0   ; 128: 0x88 board, 0 empty else $10|id
0095   5003             CAPS    .EQU RAM+$140   ; 21 : BCAP0,WCAP1,BCAP1,WCAP2,BCAP2 then 4 state groups
0096   5003             CNTS    .EQU CAPS+5     ;      group g at CNTS+STATE : MOB,MAXC,CC,PCAP
0097   5003             USTACK  .EQU RAM+$160   ; undo records, 8 bytes each (32 deep)
0098   5003             MLIST   .EQU RAM+$260   ; legal move list (from,to) pairs, up to 256
0099   5003             RAMEND  .EQU RAM+$460
0100   5003             
0101   5003             BCAP0   .EQU CAPS+0
0102   5003             WCAP1   .EQU CAPS+1
0103   5003             BCAP1   .EQU CAPS+2
0104   5003             WCAP2   .EQU CAPS+3
0105   5003             BCAP2   .EQU CAPS+4
0106   5003             BMOB    .EQU CNTS+0
0107   5003             BMAXC   .EQU CNTS+1
0108   5003             BMCC    .EQU CNTS+2
0109   5003             BMAXP   .EQU CNTS+3
0110   5003             XMAXC   .EQU CNTS+5
0111   5003             WMOB    .EQU CNTS+8
0112   5003             WMAXC   .EQU CNTS+9
0113   5003             WCC     .EQU CNTS+10
0114   5003             WMAXP   .EQU CNTS+11
0115   5003             PMOB    .EQU CNTS+12
0116   5003             PMAXC   .EQU CNTS+13
0117   5003             PCC     .EQU CNTS+14
0118   5003             
